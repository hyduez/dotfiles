{
	"layer": "top",
	"position": "top",
	"margin-top": 10,
	"width": 1900,
	"modules-left": [
		"clock",
		"group/main",
		"tray",
		"dwl/tags",
		"mpris"
	],
	"modules-center": [],
	"modules-right": ["network", "pulseaudio"],
	"clock": {
		"format": " {:%A %H:%M}", // AM PM format
		//"format": "  {:%H:%M}",// 24H
		"format-alt": "{:%e %B %y}",
		"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
	},

	"pulseaudio": {
		"format": "{icon} {volume}%",
		"format-bluetooth": "{icon} {volume}%",
		"format-muted": "󰝟",
		"format-icons": {
			"alsa_output.pci-0000_00_1f.3.analog-stereo": "",
			"alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
			"headphone": "",
			"hands-free": "",
			"headset": "",
			"phone": "",
			"phone-muted": "",
			"portable": "",
			"car": "",
			"default": ["", ""]
		},
		"scroll-step": 1,
		"on-click": "pavucontrol",
		"ignored-sinks": ["Easy Effects Sink"]
	},

	"network": {
		"format": "{ifname}",
		"format-wifi": "{icon} {ifname}",
		"format-ethernet": "󱚻 {ifname}",
		"format-disconnected": "󰌙",
		"tooltip-format": "{ipaddr}  {bandwidthUpBits}  {bandwidthDownBits}",
		"format-linked": "󰈁 {ifname} (No IP)",
		"tooltip-format-wifi": "{essid} {icon} {signalStrength}%",
		"tooltip-format-ethernet": "{ifname} 󱚻",
		"tooltip-format-disconnected": "󰌙 Disconnected",
		"max-length": 30,
		"format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
		"on-click": "omarchy-launch-wifi"
	},

	"dwl/tags": {
		"format": "{icon}",
		"format-icons": {
			"1": "A",
			"2": "B",
			"3": "C",
			"4": "D",
			"5": "E",
			"6": "F",
			"7": "G",
			"8": "H",
			"9": "I",
			"10": "J"
		},
		"persistent-workspaces": {
			"*": 5
		}
	},

	"tray": {
		"icon-size": 12,
		"spacing": 6,
		"icons": {
			"blueman": "bluetooth",
			"TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
		}
	},

	"mpris": {
		"interval": 10,
		"format": "{player_icon} {dynamic}",
		"format-paused": "{status_icon} {artist} {title}",
		"on-click-middle": "playerctl play-pause",
		"on-click": "playerctl previous",
		"on-click-right": "playerctl next",
		"scroll-step": 5.0,
		"smooth-scrolling-threshold": 1,
		"tooltip": true,
		"tooltip-format": "{status_icon} {dynamic}\nLeft Click: previous\nMid Click: Pause\nRight Click: Next",
		"player-icons": {
			"chromium": "",
			"default": "",
			"firefox": "",
			"mopidy": "",
			"mpv": "󰐹",
			"spotify": "",
			"vlc": "󰕼"
		},
		"status-icons": {
			"paused": "󰐎",
			"playing": "",
			"stopped": ""
		},
		"dynamic-order": ["artist", "title"],
		"max-length": 50
	},
	"custom/vicinae": {
		"format": "",
		"on-click": "fuzzel",
		"interval": 0,
		"tooltip-format": "Vicinae\n\nSuper + Space"
	},
	
    //Groups..

	"group/main": {
		"orientation": "inherit",
		"modules": ["custom/vicinae"]
	},

	// Separators

	"custom/separator#dot": {
		"format": "",
		"interval": "once",
		"tooltip": false
	},
	"custom/separator#dot-line": {
		"format": "",
		"interval": "once",
		"tooltip": false
	},
	"custom/separator#tinyr": {
		"format": "›",
		"interval": "once",
		"tooltip": false
	},
	"custom/separator#tinyl": {
		"format": "‹",
		"interval": "once",
		"tooltip": false
	},
	"custom/separator#aright": {
		"format": "",
		"interval": "once",
		"tooltip": false
	},
	"custom/separator#aleft": {
		"format": "",
		"interval": "once",
		"tooltip": false
	},
	"custom/separator#line": {
		"format": "|",
		"interval": "once",
		"tooltip": false
	},
	"custom/separator#blank": {
		"format": " ",
		"interval": "once",
		"tooltip": false
	},
	"custom/separator#blank_2": {
		"format": "  ",
		"interval": "once",
		"tooltip": false
	},
	"custom/separator#blank_3": {
		"format": "   ",
		"interval": "once",
		"tooltip": false
	},
	"custom/arrow1": {
		"format": "",
		"tooltip": false
	},

	"custom/arrow2": {
		"format": "",
		"tooltip": false
	},

	"custom/arrow3": {
		"format": "",
		"tooltip": false
	},

	"custom/arrow4": {
		"format": "",
		"tooltip": false
	},

	"custom/arrow5": {
		"format": "",
		"tooltip": false
	},

	"custom/arrow6": {
		"format": "",
		"tooltip": false
	},

	"custom/arrow7": {
		"format": "",
		"tooltip": false
	},

	"custom/arrow8": {
		"format": "",
		"tooltip": false
	},

	"custom/arrow9": {
		"format": "",
		"tooltip": false
	},

	"custom/arrow10": {
		"format": "",
		"tooltip": false
	}
}
