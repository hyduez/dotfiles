// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "modules-left": [
        "mango/workspaces",
        "mango/window",
        "mango/layout"
    ],
    "modules-center": [
        "temperature",
        "clock",
        "cpu"
    ],
    "modules-right": [
        "wireplumber",
        "network",
        "memory",
        "disk",
        "tray",
        "custom/lock"
    ],
    "mango/layout": {
        "format": "[{}]:"
    },
    "mango/window": {
        "format": "  {}",
        "icon": true,
        "icon-size": 14,
        "max-length": 30
    },
    "mango/workspaces": {
        "on-click": "activate",
        "on-click-right": "toggle",
        "format": "{icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "6": "",
            "7": "",
            "8": "",
            "9": ""
        }
    },
    "tray": {
        "icon-size": 10,
        "spacing": 10
    },
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%Y-%m-%d %H:%M} 󰃱",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 4,
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#78a9ff'><b>{}</b></span>",
                "weeks": "<span color='#82cfff'><b>W{}</b></span>",
                "weekdays": "<span color='#ff7eb6'><b>{}</b></span>",
                "days": "<span color='#dde1e6'><b>{}</b></span>",
                "today": "<span color='#33b1ff'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "disk": {
        "format": "{percentage_used}% "
    },
    "cpu": {
        "format": "{icon0}{icon1}{icon2}{icon3} {usage:>2}% ",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "tooltip": true
    },
    "memory": {
        "format": "{used:0.2f}GiB  {total}GiB "
    },
    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""],
        "tooltip-format": "CPU's Temperature"
    },
   "network": {
        "format-wifi": "Wi-Fi ({signalStrength}%) ",
        "format-ethernet": "Connected 󰈀",
        "tooltip-format": "Signal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>\nSpeed: <b>{bandwidthTotalBytes}</b>",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ipaddr}/{cidr}"
    },
    "wireplumber": {
        "format": "{volume}% {icon}  {format_source}",
        "format-bluetooth": "{volume}% {icon}  {format_source}",
        "format-bluetooth-muted": "{icon} {format_source}",
        "format-muted": "{format_source}",
        "format-source": " <span color='#b9fbc0'>{volume}% </span>",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "󰕾",
            "hands-free": "󰕾",
            "headset": "󰋋",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "custom/lock": {
        "format" : "    ",
        "on-click": "waylock"
    }
}
