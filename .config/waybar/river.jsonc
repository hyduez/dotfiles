// -*- mode: jsonc -*-
{
    "layer": "top", // Waybar at top layer
    // "position": "top", // Waybar position (top|bottom|left|right)
    "height": 0, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 0, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "river/tags",
    ],
    "modules-center": [
        "temperature",
        "clock",
        "cpu",
        "custom/notification",
    ],
    "modules-right": [
        "wireplumber",
        "network",
        "memory",
        "disk",
        "tray",
        "custom/lock"
    ],
    "river/tags": {
        "num-tags": 9,
        "tag-labels": ["1: ", "2: ", "3: 󰈹", "4: ", "5: ", "6: ", "7: ", "8: ", "9: "],
        "hide-vacant": true
    },
    "tray": {
        "icon-size": 12,
        "spacing": 10
    },
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%Y-%m-%d %H:%M} 󰃱"
    },
    "disk": {
        "format": "{percentage_used}% "
    },
    "cpu": {
        "format": "{icon0}{icon1}{icon2}{icon3} {usage:>2}% ",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "tooltip": false
    },
    "memory": {
        "format": "{used}GiB/{total}GiB "
    },
    "temperature": {
        // "thermal-zone": 2,
        "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""],
        "tooltip-format": "CPU's Temperature"
    },
    "custom/notification": {
        "format": "󰂚",
        "tooltip-format": "Notifications Center",
        "on-click": "swaync-client -t -sw"
    },
    "network": {
        "format-wifi": "Wi-Fi ({signalStrength}%) ",
        "format-ethernet": "Connected 󰈀",
        "tooltip-format": "{ifname} via {gwaddr}",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ipaddr}/{cidr}"
    },
    "wireplumber": {
        "format": "{volume}% {icon}  {format_source}",
        "format-bluetooth": "{volume}% {icon}  {format_source}",
        "format-bluetooth-muted": "{icon} {format_source}",
        "format-muted": "{format_source}",
        "format-source": "<span color='#b9fbc0'>{volume}% </span>",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "󰕾",
            "hands-free": "󰕾",
            "headset": "󰋋",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "custom/lock": {
        "format" : "    ",
        "on-click": "waylock",
		    "tooltip": true,
    }
}
